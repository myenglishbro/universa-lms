# Copiar a .env.local (ignorado por git) y completar con los datos de tu proyecto Supabase:
# Project Settings -> API. Usar SOLO la clave anon/publishable. Nunca la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Opcional: URL pública del Strapi (universa-strapi-project) con el contenido de la landing.
# Requiere permisos de lectura (find) para el rol Public en homepage y site-setting. Sin esto se usa el contenido incluido.
# VITE_STRAPI_URL=https://tu-strapi.example.com
